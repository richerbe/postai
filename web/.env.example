# PostAI SaaS 환경변수 설정
# 이 파일을 .env 로 복사한 후 실제 값을 입력하세요
# cp .env.example .env

# ── Flask 서버 ────────────────────────────────────────────
# 랜덤 비밀키 (python3 -c "import secrets; print(secrets.token_hex(32))" 로 생성)
SECRET_KEY=change-me-to-random-secret-key

# ── Stripe 결제 ───────────────────────────────────────────
# Stripe 대시보드 → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# Stripe 대시보드 → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe 대시보드 → Products → 각 상품 Price ID
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# ── 로컬 테스트용 설정 ────────────────────────────────────
# Stripe CLI 웹훅 테스트: stripe listen --forward-to localhost:5000/stripe-webhook
# 테스트 카드 번호: 4242 4242 4242 4242 (만료: 미래 날짜, CVC: 아무 숫자)
